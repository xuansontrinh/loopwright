{
  "title": "loopwright review verdict",
  "type": "object",
  "required": ["pass", "blocking", "undecided", "droppedCount", "siblings"],
  "additionalProperties": false,
  "properties": {
    "pass": { "type": "boolean", "description": "True only when blocking and undecided are both empty." },
    "blocking": { "type": "array", "items": { "$ref": "#/$defs/Finding" } },
    "undecided": { "type": "array", "items": { "$ref": "#/$defs/Finding" } },
    "droppedCount": { "type": "integer" },
    "siblings": {
      "type": "array",
      "description": "Other places with the same defect (fix tasks); empty otherwise. Never blocking.",
      "items": { "$ref": "#/$defs/Sibling" }
    }
  },
  "$defs": {
    "Sibling": {
      "type": "object",
      "required": ["path", "line", "why"],
      "additionalProperties": false,
      "properties": {
        "path": { "type": "string" },
        "line": { "type": "integer" },
        "why": { "type": "string" }
      }
    },
    "Finding": {
      "type": "object",
      "required": ["location", "expectation", "proof", "impact", "confidence"],
      "additionalProperties": false,
      "properties": {
        "location": { "type": "string" },
        "expectation": { "type": "string" },
        "proof": { "type": "string" },
        "impact": { "type": "string", "enum": ["high"] },
        "confidence": { "type": "string", "enum": ["high", "mid", "low"] }
      }
    }
  }
}
