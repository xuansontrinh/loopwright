{
  "name": "loopwright",
  "author": "Xuan Son Trinh",
  "version": "0.1.3",
  "description": "Agent workflow installer for Claude Code, Codex and Junie",
  "type": "module",
  "bin": {
    "loopwright": "./dist/cli.js"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/xuansontrinh/loopwright.git"
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit",
    "pretest": "npm run build",
    "test": "vitest run",
    "dev": "npm run build && node dist/cli.js",
    "prepublishOnly": "npm run build",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "files": [
    "dist/",
    "content/"
  ],
  "engines": {
    "node": ">=22.14"
  },
  "keywords": [
    "ai",
    "skills",
    "spec-driven",
    "development"
  ],
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^22.20.5",
    "prettier": "^3.9.10",
    "smol-toml": "^1.9.1",
    "tsdown": "^0.23.7",
    "typescript": "^7.0.2",
    "unrun": "^0.3.1",
    "vitest": "^5.0.5"
  }
}
